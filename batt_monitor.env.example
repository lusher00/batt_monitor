# Replace the divider with the calibrated value for this machine.
# Three critical readings are normally required. A first critical reading may
# trigger immediately after at least two continuous hours below the warning
# threshold and a net drop of at least 0.30 V.
BATT_MONITOR_ARGS=--watch --shutdown --channel 5 --divider 11.2702 --cells 3 --interval 10 --confirm-samples 3 --trend-hours 2 --trend-drop 0.30 --shutdown-grace 15
