[Unit]
Description=Battery voltage boot check
# Publish an early reading before network and balance_bot start. The continuous
# watcher owns coordinated shutdown once Robot Link can reach the Pi.
DefaultDependencies=no
After=local-fs.target
Before=network.target sysinit.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/batt_monitor --check
RemainAfterExit=no

[Install]
WantedBy=sysinit.target
